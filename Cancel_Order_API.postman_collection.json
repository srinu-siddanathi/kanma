{
	"info": {
		"_postman_id": "cancel-order-api-only",
		"name": "Cancel Order API Only",
		"description": "Single endpoint for cancelling orders with automatic refund processing",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Cancel Order",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/orders/{{order_id}}/cancel",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"orders",
						"{{order_id}}",
						"cancel"
					]
				},
				"description": "Cancels an existing order with automatic refund processing for Razorpay payments and wallet refunds."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "order_id",
			"value": "1",
			"type": "string"
		}
	]
} 