{
	"info": {
		"_postman_id": "coupon-apis-simplified",
		"name": "Coupon APIs - Simplified Approach",
		"description": "API collection for coupon management with validate-and-apply approach",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Validate and Apply Coupon",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"coupon_code\": \"SAVE20\",\n    \"user_id\": 1,\n    \"order_amount\": 500.00\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/coupons/validate-and-apply",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"coupons",
						"validate-and-apply"
					]
				},
				"description": "Validates a coupon code and creates a pending usage record. Call this before creating the order."
			},
			"response": []
		},
		{
			"name": "Get Available Coupons",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/coupons/available?user_id=1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"coupons",
						"available"
					],
					"query": [
						{
							"key": "user_id",
							"value": "1"
						}
					]
				},
				"description": "Returns all available coupons for a user."
			},
			"response": []
		},
		{
			"name": "Confirm Coupon Usage",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"usage_id\": 5\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/coupons/confirm-usage",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"coupons",
						"confirm-usage"
					]
				},
				"description": "Confirms coupon usage after successful payment. Use the usage_id from validate-and-apply response."
			},
			"response": []
		},
		{
			"name": "Fail Coupon Usage",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"usage_id\": 5\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/coupons/fail-usage",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"coupons",
						"fail-usage"
					]
				},
				"description": "Marks coupon usage as failed after payment failure. Use the usage_id from validate-and-apply response."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		}
	]
} 