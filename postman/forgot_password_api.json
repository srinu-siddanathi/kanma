{
	"info": {
		"_postman_id": "forgot-password-api-collection",
		"name": "Forgot Password API",
		"description": "Collection for testing forgot password functionality",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Send OTP for Forgot Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"phone\": \"9876543210\",\n    \"otp\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/forgot-password/send-otp",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"forgot-password",
						"send-otp"
					]
				},
				"description": "Sends OTP to the provided mobile number for password reset. The Android app generates the OTP locally and sends it to the server for SMS delivery."
			},
			"response": []
		},
		{
			"name": "Reset Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"phone\": \"9876543210\",\n    \"otp\": \"123456\",\n    \"new_password\": \"newSecurePassword123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/forgot-password/reset",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"forgot-password",
						"reset"
					]
				},
				"description": "Resets the user's password after OTP verification. This endpoint is called after the Android app verifies the OTP locally."
			},
			"response": []
		},
