	"item": [
		{
			"name": "Login with Device Token",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{user_email}}\",\n    \"password\": \"{{user_password}}\",\n    \"device_token\": \"{{device_token}}\",\n    \"device_type\": \"android\",\n    \"app_version\": \"1.0.0\",\n    \"device_model\": \"Samsung Galaxy S21\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"login"
					]
				},
				"description": "Login with email/password and register device token for push notifications. This is the recommended way to register device tokens during user authentication."
			},
			"response": []
		},
