	"item": [
		{
			"name": "Calculate Checkout Fees",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"cart_items\": [\n        {\n            \"product_id\": 1,\n            \"quantity\": 2,\n            \"variant_id\": null\n        },\n        {\n            \"product_id\": 3,\n            \"quantity\": 1,\n            \"variant_id\": 5\n        }\n    ],\n    \"delivery_latitude\": 12.9716,\n    \"delivery_longitude\": 77.5946,\n    \"branch_id\": 1\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/checkout/calculate-fees",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"checkout",
						"calculate-fees"
					]
				},
				"description": "Calculate delivery fee and small cart fee based on cart items and user membership status."
			},
			"response": []
		},
		{
			"name": "Get Checkout Summary",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/checkout/summary?delivery_latitude=12.9716&delivery_longitude=77.5946&branch_id=1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"checkout",
						"summary"
					],
					"query": [
						{
							"key": "delivery_latitude",
							"value": "12.9716",
							"description": "Delivery latitude coordinate"
						},
						{
							"key": "delivery_longitude",
							"value": "77.5946",
							"description": "Delivery longitude coordinate"
						},
						{
							"key": "branch_id",
							"value": "1",
							"description": "Branch ID for distance calculation"
						}
					]
				},
				"description": "Get checkout summary using items from user's cached cart."
			},
			"response": []
		},
